meta {
  name: Get album by id
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/albums/1
  body: none
  auth: none
}

tests {
  test("returns album details and tracks", function() {
    expect(res.status).to.equal(200);
    expect(res.body.albumId).to.equal(1);
    expect(res.body.title).to.be.a("string");
    expect(res.body.tracks).to.be.an("array");
  });
}
