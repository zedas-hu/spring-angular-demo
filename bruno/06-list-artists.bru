meta {
  name: List artist keys
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/artists/keys
  body: none
  auth: none
}

tests {
  test("returns artist key and value pairs", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    expect(res.body.length).to.be.greaterThan(0);
    expect(res.body[0]).to.have.all.keys("key", "value");
  });
}
