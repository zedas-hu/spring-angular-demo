meta {
  name: Update track
  type: http
  seq: 21
}

put {
  url: {{baseUrl}}/api/tracks/{{testTrackId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "{{testTrackUpdatedName}}",
    "albumId": {{testAlbumId}},
    "genreId": 1,
    "mediaTypeId": 1,
    "composer": "Updated by Bruno",
    "milliseconds": 181000,
    "unitPrice": 1.29
  }
}

script:pre-request {
  bru.setVar("testTrackUpdatedName", "Bruno API updated track " + Date.now());
}

tests {
  test("updates the requested track", function() {
    expect(res.status).to.equal(200);
    expect(res.body.trackId).to.equal(bru.getVar("testTrackId"));
    expect(res.body.name).to.equal(bru.getVar("testTrackUpdatedName"));
    expect(res.body.composer).to.equal("Updated by Bruno");
    expect(res.body.milliseconds).to.equal(181000);
  });
}
