meta {
  name: Search tracks
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/tracks?filter=balls&page=0&size=10&sort=name%2Casc
  body: none
  auth: none
}

tests {
  test("filters tracks by their name or album title", function() {
    expect(res.status).to.equal(200);
    expect(res.body.content).to.be.an("array");
    expect(res.body.content.some(track => track.name.toLowerCase().includes("balls") || track.albumTitle.toLowerCase().includes("balls"))).to.equal(true);
  });
}
