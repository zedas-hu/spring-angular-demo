meta {
  name: Get track by id
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/tracks/1
  body: none
  auth: none
}

tests {
  test("returns track details", function() {
    expect(res.status).to.equal(200);
    expect(res.body.trackId).to.equal(1);
    expect(res.body.name).to.be.a("string");
    expect(res.body.albumId).to.be.a("number");
  });
}
